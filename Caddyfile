:80 {
    root * /srv
    encode zstd gzip

    handle /api/health {
        header Content-Type "application/json"
        header Cache-Control "no-store"
        respond `{"ok":true,"version":"{$GOVSIM_CODE_VERSION:unknown}"}` 200
    }

    @immutable path /assets/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"

    handle {
        header {
            X-Content-Type-Options "nosniff"
            X-Frame-Options "DENY"
            Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://*.r2.cloudflarestorage.com;"
        }
        try_files {path} /index.html
        file_server
    }
}
